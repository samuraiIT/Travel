[Unit]
Description=Travel Hermes low-priority emergency swap reserve
Documentation=file:/opt/project_llm/projects/Travel/docs/OPERATIONS_HANDOFF.md
RequiresMountsFor=/opt
ConditionPathExists=/opt/travel-swap/swap-emergency.img
Before=swap.target

[Swap]
What=/opt/travel-swap/swap-emergency.img
Priority=-1
TimeoutSec=90s

[Install]
WantedBy=swap.target
